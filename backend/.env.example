# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_db_password_here
DB_NAME=ai_meeting_db

# Google Calendar API
GOOGLE_CLIENT_ID=your_google_client_id_here
