# NCP API Credentials
NCP_ACCESS_KEY=your_ncp_access_key_here
NCP_SECRET_KEY=your_ncp_secret_key_here

# CLOVA Speech API
CLOVA_SPEECH_INVOKE_URL=your_clova_speech_url_here
CLOVA_SPEECH_SECRET_KEY=your_clova_speech_secret_here

# CLOVA Studio (HyperCLOVA X)
CLOVA_STUDIO_API_KEY=your_clova_studio_key_here
